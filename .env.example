# Shared observer. No per-customer feed, token, or private payload.
# Local Next.js: copy this file to .env.local (git ignores it).
# Vercel: Project → Settings → Environment Variables, then redeploy.
# Meanings and where to obtain each value: README.md, Environment variables.

SOURCE_BASE_URL=https://evidence.example
REGISTRY_SOURCE_API_KEY=
REGISTRY_PUBLISHER_PUBLIC_KEY=replace-with-independently-pinned-unpadded-base64url-spki
REGISTRY_SIGNED_GENESIS=replace-with-independently-pinned-unpadded-base64url-canonical-signed-genesis

# Supabase on Vercel: Connect → Transaction pooler → URI.
# Host *.pooler.supabase.com, port 6543, user postgres.[project-ref], database postgres.
# Append ?sslmode=verify-full when the copied URI has no sslmode parameter.
# The https://[project-ref].supabase.co project URL, API keys, and db.[project-ref].supabase.co:5432 are different Connect values.
DATABASE_URL=postgresql://observer:password@database.example/observer
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?sslmode=verify-full

# Optional. The migrations always install schema observer. Set this only if you
# want startup to fail when the variable is still present and is not observer.
# OBSERVER_SCHEMA=observer
CRON_SECRET=replace-with-at-least-32-utf8-bytes

# Generate one observer-owned ECDSA P-256 keypair; pin its public key independently.
OBSERVER_SIGNING_PRIVATE_KEY=replace-with-unpadded-base64url-pkcs8
OBSERVER_SIGNING_PUBLIC_KEY=replace-with-unpadded-base64url-spki
