# Replace every value with customer-controlled configuration.
SOURCE_BASE_URL=https://evidence.example
FEED_ID=replace-with-64-lowercase-hex-characters
ANCHOR_PIN=replace-with-independently-authenticated-64-lowercase-hex-anchor-hash
SIGNED_ANCHOR=replace-with-canonical-unpadded-base64url-of-canonical-signed-anchor-json
DATABASE_URL=postgresql://observer:password@database.example/observer
# Use public for a dedicated database; create a dedicated schema for a shared/Supabase project.
OBSERVER_SCHEMA=public
CRON_SECRET=replace-with-at-least-32-utf8-bytes
REPORT_READ_TOKEN=replace-with-a-different-at-least-32-utf8-byte-secret
# Generate one observer-owned ECDSA P-256 keypair; pin its public key independently.
OBSERVER_SIGNING_PRIVATE_KEY=replace-with-unpadded-base64url-pkcs8
OBSERVER_SIGNING_PUBLIC_KEY=replace-with-unpadded-base64url-spki
