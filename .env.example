# Shared observer: no customer-specific feed, token or private payload.
SOURCE_BASE_URL=https://evidence.example
REGISTRY_PUBLISHER_PUBLIC_KEY=replace-with-independently-pinned-base64url-spki
REGISTRY_SIGNED_GENESIS=replace-with-independently-pinned-base64url-canonical-signed-genesis
DATABASE_URL=postgresql://observer:password@database.example/observer
# Create this schema and grant the observer role USAGE and CREATE before deployment.
OBSERVER_SCHEMA=public
CRON_SECRET=replace-with-at-least-32-utf8-bytes
OBSERVER_SIGNING_PRIVATE_KEY=replace-with-base64url-pkcs8
OBSERVER_SIGNING_PUBLIC_KEY=replace-with-base64url-spki

# Legacy single-feed profile only; not used by the shared cron.
# FEED_ID=replace-with-64-lowercase-hex-characters
# ANCHOR_PIN=replace-with-independently-pinned-64-lowercase-hex-anchor-hash
# SIGNED_ANCHOR=replace-with-base64url-canonical-signed-anchor
# REPORT_READ_TOKEN=replace-with-a-different-at-least-32-byte-secret
